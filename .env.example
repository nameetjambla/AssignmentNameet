# Playwright Configuration
BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# Test Environment
BASE_URL=https://www.booking.com/flights/index.en-gb.html
TIMEOUT=30000
SCREENSHOT_ON_FAILURE=true

# Flight Search Test Data
TEST_DEPARTURE=DEL
TEST_DESTINATION=BOM
TEST_DATE_FORMAT=YYYY-MM-DD

# Reporting
REPORT_PATH=./test-results
SCREENSHOT_PATH=./screenshots
VIDEO_PATH=./videos

# Retry Configuration
RETRY_ATTEMPTS=2
RETRY_DELAY=1000

# Debug Mode
DEBUG=false
TRACE_ON_FAILURE=true
VIDEO_ON_FAILURE=true
